<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <layer-list>
            <item android:top="3dp">
                <shape>
                    <solid android:color="#55FF7A59" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape>
                    <corners android:radius="20dp" />
                    <gradient
                        android:angle="0"
                        android:startColor="#FF7A59"
                        android:centerColor="#FF5EA8"
                        android:endColor="#7C6BFF" />
                    <stroke
                        android:width="1dp"
                        android:color="#90FFFFFF" />
                    <padding
                        android:left="16dp"
                        android:top="10dp"
                        android:right="16dp"
                        android:bottom="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
